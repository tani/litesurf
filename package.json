{
  "name": "litesurf",
  "version": "0.0.1",
  "description": "Run the Kitesurf browser engine locally from Node.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tani/litesurf.git"
  },
  "bin": {
    "litesurf": "./bin/litesurf.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "dist/",
    "docs/development.md",
    "docs/releasing.md",
    "docs/audits/README.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./dist/types/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.mts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:types",
    "start": "node bin/litesurf.mjs",
    "check": "npm run check:types && node scripts/check.mjs",
    "check:upstream": "node scripts/verify-upstream.mjs",
    "test": "node --test test/runtime.test.mjs test/upstream.test.mjs test/cli.test.mjs",
    "test:e2e": "node --test test/runtime.e2e.test.mjs",
    "test:package": "node --test test/package.e2e.test.mjs",
    "prepack": "npm run build:types && node scripts/verify-package.mjs",
    "release:prepare": "node scripts/release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "clean": "node scripts/clean.mjs",
    "test:release": "node --test test/release.test.mjs test/publish.test.mjs",
    "build:types": "tsc -p tsconfig.json",
    "check:types": "npm run build:types && tsc -p test/tsconfig.json",
    "prepublishOnly": "node scripts/verify-publish.mjs",
    "release:verify-public": "node scripts/verify-publish.mjs"
  },
  "dependencies": {
    "miniflare": "5.20260911.1-alpha"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "puppeteer-core": "25.16.0",
    "smol-toml": "1.9.1",
    "tar": "7.5.23",
    "typescript": "7.0.2",
    "zx": "8.8.5"
  },
  "engines": {
    "node": ">=22"
  }
}
