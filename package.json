{
  "name": "litesurf",
  "version": "0.0.1",
  "description": "Run the Kitesurf browser engine locally from Node.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tani/litesurf.git"
  },
  "bin": {
    "litesurf": "./bin/litesurf.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "dist/",
    "docs/development.md",
    "docs/releasing.md",
    "docs/audits/README.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./dist/types/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.mts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    },
    "./package.json": "./package.json",
    "./dom": {
      "types": "./dist/types/dom.d.mts",
      "import": "./src/dom.mjs",
      "default": "./src/dom.mjs"
    },
    "./vitest": {
      "types": "./dist/types/vitest.d.mts",
      "import": "./src/vitest.mjs",
      "default": "./src/vitest.mjs"
    },
    "./bun": {
      "types": "./dist/types/bun.d.mts",
      "import": "./src/bun.mjs",
      "default": "./src/bun.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "bench:dom": "node scripts/benchmark-dom.mjs",
    "build": "node scripts/build.mjs && npm run build:types",
    "start": "node bin/litesurf.mjs",
    "check": "npm run check:types && node scripts/check.mjs",
    "check:upstream": "node scripts/verify-upstream.mjs",
    "test": "node --test test/runtime.test.mjs test/upstream.test.mjs test/cli.test.mjs test/dom.test.mjs",
    "test:e2e": "node --test test/runtime.e2e.test.mjs",
    "test:package": "node --test test/package.e2e.test.mjs",
    "prepack": "npm run build:types && node scripts/verify-package.mjs",
    "release:prepare": "node scripts/release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "clean": "node scripts/clean.mjs",
    "test:release": "node --test test/release.test.mjs test/publish.test.mjs",
    "build:types": "tsc -p tsconfig.json",
    "check:types": "npm run build:types && tsc -p test/tsconfig.json",
    "prepublishOnly": "node scripts/verify-publish.mjs",
    "release:verify-public": "node scripts/verify-publish.mjs",
    "test:vitest": "vitest run --config test/adapters/vitest.config.mjs",
    "test:bun": "bun test --preload litesurf/bun ./test/adapters/dom.bun.test.mjs ./test/adapters/react.bun.test.mjs"
  },
  "dependencies": {
    "miniflare": "5.20260911.1-alpha"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "1.9.1",
    "tar": "7.5.23",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "zx": "8.8.5"
  },
  "peerDependencies": {
    "vitest": "^4.1.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
